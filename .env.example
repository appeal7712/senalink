VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 슈퍼관리자 문서는 앱에서 만들 수 없음.
# Firebase 콘솔 → Firestore → admins/{구글UID} 문서, 내용 { "role": "super" }
# 로컬 에뮬레이터는 npm run seed:admin -- <UID>

# ----- 정식 배포 전 Firebase 콘솔에서 할 일 -----
# 1) Authentication
#    - Google 제공업체 사용 설정
#    - 승인된 도메인에 Hosting 주소 추가 (예: senalink.web.app)
#    - 익명 로그인 사용 중지 (정식은 구글만)
# 2) Firestore
#    - 규칙 배포: firebase deploy --only firestore:rules
#    - admins/{본인구글UID} 문서 생성 { "role": "super" }  → /ops 진입용
# 3) Storage
#    - 규칙 배포: firebase deploy --only storage
# 4) Functions (60일 무활동 허브 삭제) — Blaze(종량제) 필요
#    - firebase deploy --only functions
#    - 서울 리전 asia-northeast3, 매일 04:00 KST purgeIdleHubs
# 5) Hosting
#    - 김봉이 요청하기 전에는 배포하지 않음
