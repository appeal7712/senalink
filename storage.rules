rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 마이페이지 프로필 — 본인 uid 경로만 덮어쓰기
    match /userAvatars/{uid}/avatar.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 500 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|jpg|webp)');
    }

    // 길드 마크 — 프로필과 동일하게 본인 uid 하위만 쓰기 허용
    // (허브에 표시할 URL 저장은 Firestore hubs 규칙(canRunHub)이 막음)
    // firestore.get 기반 검사는 Storage↔Firestore 연동/쿼터 이슈로 unauthorized가 나기 쉬워 사용하지 않음
    match /hubEmblems/{hubId}/byUser/{uid}/mark.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 500 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|jpg|webp)');
    }

    // 구경로 읽기 호환 (과거 mark.jpg URL)
    match /hubEmblems/{hubId}/mark.jpg {
      allow read: if true;
      allow write: if false;
    }
  }
}
